{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cv",
  "compatibility_date": "2026-10-12",
  "workers_dev": true,
  "routes": [
    { "pattern": "fragged.org/cv*", "zone_name": "fragged.org" },
    { "pattern": "www.fragged.org/cv*", "zone_name": "fragged.org" }
  ],
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist"
  }
}
